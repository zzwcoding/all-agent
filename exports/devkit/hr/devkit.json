      "id": "QR-HR-001",
      "name": "员工薪酬明细查询",
      "alias": "salaryDetailQuery",
      "objectType": "STATISTICAL_QUERY",
      "questionSample": "员工薪酬明细查询",
      "sourceNote": "",
      "description": "员工粒度薪酬轨迹出口（R14·salaries 表直读）：期间薪档+起止区间+现行标记（Q3：哨兵注记为数据惯例，判定语义 RULE-HR-003）。",
      "behavior": {
        "id": "BH-HR-QuerySalary",
        "name": "查询员工薪酬",
        "type": "QUERY",
        "triggerType": "",
        "ownerEntity": "AGG-HR-006",
        "sourceNote": ""
      },
      "sourceObjects": [
        {
          "objectRef": "AGG-HR-006",
          "alias": "s",
          "primary": true,
          "name": "薪酬记录"
        },
        {
          "objectRef": "AGG-HR-001",
          "alias": "e",
          "primary": false,
          "name": "员工"
        }
      ],
      "parameters": [
        {
          "name": "startDay",
          "label": "生效起始日",
          "dataType": "Date",
          "required": true,
          "allowedOperators": []
        },
        {
          "name": "endDay",
          "label": "生效截止日",
          "dataType": "Date",
          "required": true,
          "allowedOperators": []
        }
      ],
      "conditions": [
        {
          "conditionId": "COND-HR-001",
          "leftExpression": "s.fromDate",
          "operator": "BETWEEN",
          "parameterRef": "startDay"
        }
      ],
      "resultColumns": [
        {
          "name": "empNo",
          "label": "员工编号",
          "dataType": "Integer",
          "sourceExpression": "e.empNo"
        },
        {
          "name": "fullName",
          "label": "姓名",
          "dataType": "String",
          "sourceExpression": "CONCAT(e.lastName, ' ', e.firstName)"
        },
        {
          "name": "salary",
          "label": "期间薪档",
          "dataType": "Integer",
          "sourceExpression": "s.salary"
        },
        {
          "name": "fromDate",
          "label": "生效日期",
          "dataType": "Date",
          "sourceExpression": "s.fromDate"
        },
        {
          "name": "toDate",
          "label": "截止日期",
          "dataType": "Date",
          "sourceExpression": "s.toDate"
        },
        {
          "name": "isCurrent",
          "label": "是否现行",
          "dataType": "Boolean",
          "sourceExpression": "s.toDate == DATE '9999-01-01'"
        }
      ],
      "rules": [
        {
          "id": "RULE-HR-002",
          "name": "薪酬一期一条",
          "type": "VALIDATION",
          "point": {
            "expression": "COUNT(*) == COUNT(DISTINCT (empNo, fromDate))"
          },
          "via": "behavior.appliedRules(BH-HR-QuerySalary)"
        },
        {
          "id": "RULE-HR-001",
          "name": "性别代码值域",
          "type": "VALIDATION",
          "point": {
            "expression": "gender == 'M' or gender == 'F'"
          },
          "via": "ownerObjectBehaviors(AGG-HR-001)"
        },
        {
          "id": "RULE-HR-008",
          "name": "人司年限口径",
          "type": "CALCULATION",
          "point": {
            "expression": "DATEDIFF(asOfDay, hireDate) / 365.25"
          },
          "via": "ownerObjectBehaviors(AGG-HR-001)"
        }
      ],
      "hitIds": [
        "QR-HR-001",
        "BH-HR-QuerySalary",
        "AGG-HR-006",
        "AGG-HR-001",
        "RULE-HR-002",
        "RULE-HR-001",
        "RULE-HR-008"
      ]
    },
