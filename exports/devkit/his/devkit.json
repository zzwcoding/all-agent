      ],
      "conditions": [
        {
          "conditionId": "COND-HIS-001",
          "leftExpression": "r.visitDay",
          "operator": "BETWEEN",
          "parameterRef": "startDay"
        }
      ],
      "resultColumns": [
        {
          "name": "visitDay",
          "label": "统计日期",
          "dataType": "Date",
          "sourceExpression": "r.visitDay"
        },
        {
          "name": "registerCnt",
          "label": "挂号人次",
          "dataType": "Integer",
          "sourceExpression": "COUNT(r.caseNumber)"
        },
        {
          "name": "registerRevenue",
          "label": "挂号收入（元）",
          "dataType": "Decimal",
          "sourceExpression": "SUM(r.registerFee)"
        },
        {
          "name": "refundCnt",
          "label": "退号数",
          "dataType": "Integer",
          "sourceExpression": "COUNT(CASE WHEN r.visitStatus = '已退号' THEN 1 END)"
        },
        {
          "name": "prescriptionCnt",
          "label": "处方数",
          "dataType": "Integer",
          "sourceExpression": "COUNT(p.prescribeDay)"
        },
        {
          "name": "diseaseTypes",
          "label": "疾病种数",
          "dataType": "Integer",
          "sourceExpression": "COUNT(DISTINCT d.diseaseCode)"
        },
        {
          "name": "refundRate",
          "label": "退号率（%）",
          "dataType": "Decimal",
          "sourceExpression": "refundCnt / registerCnt * 100"
        }
      ],
      "rules": [
        {
          "id": "RULE-HIS-001",
          "name": "退号率告警阈值",
          "type": "VALIDATION",
          "point": {
            "expression": "refundRate <= 10"
          },
          "via": "behavior.appliedRules(BH-HIS-QueryDashboard)"
        },
        {
          "id": "RULE-HIS-003",
          "name": "退号率口径",
          "type": "CALCULATION",
          "point": {
            "expression": "refundCount / registerCount * 100"
          },
          "via": "behavior.appliedRules(BH-HIS-QueryDashboard)"
        },
        {
          "id": "RULE-HIS-005",
          "name": "处方退费率口径",
          "type": "CALCULATION",
          "point": {
            "expression": "refundPresc / totalPresc * 100"
          },
          "via": "behavior.appliedRules(BH-HIS-QueryDashboard)"
        },
        {
          "id": "RULE-HIS-002",
          "name": "支付方式收入占比合计校验",
          "type": "VALIDATION",
          "point": {
            "expression": "pctSum == 100"
          },
          "via": "ownerObjectBehaviors(AGG-HIS-001)"
        },
        {
          "id": "RULE-HIS-004",
          "name": "均次费用口径",
          "type": "CALCULATION",
          "point": {
            "expression": "totalRevenue / totalVisits"
          },
          "via": "ownerObjectBehaviors(AGG-HIS-001)"
        },
        {
          "id": "RULE-HIS-007",
          "name": "复诊率口径",
          "type": "CALCULATION",
          "point": {
            "expression": "revisitPatients / totalPatients * 100"
          },
          "via": "ownerObjectBehaviors(AGG-HIS-001)"
        },
        {
          "id": "RULE-HIS-006",
          "name": "病历完整率口径",
          "type": "CALCULATION",
          "point": {
            "expression": "filledDims / 5 * 100"
          },
          "via": "ownerObjectBehaviors(AGG-HIS-003)"
        }
      ],
      "hitIds": [
        "QR-HIS-001",
