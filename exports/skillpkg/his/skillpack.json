  "glossary": {
    "declared": true,
    "terms": [
      {
        "id": "GLS-HIS-001",
        "term": "HIS",
        "aliases": [
          "医院信息系统",
          "Hospital Information System"
        ],
        "status": "有效",
        "termType": "缩写",
        "definition": "医院信息系统——挂号/就诊/处方/收费/药品管理等核心业务数字化的业务系统（OLTP）；本域是它的下游报表消费平台（OLAP），源系统业务细则不在本域建模。",
        "relatedObjectRefs": []
      },
      {
        "id": "GLS-HIS-002",
        "term": "ICD-10",
        "aliases": [
          "国际疾病分类"
        ],
        "status": "有效",
        "termType": "缩写",
        "definition": "国际疾病分类第十次修订本——诊断记录的标准疾病编码体系（编码+中文病名+章节），疾病字典（DICT-HIS-001）的码表来源。",
        "relatedObjectRefs": []
      },
      {
        "id": "GLS-HIS-003",
        "term": "退号率",
        "aliases": [],
        "status": "有效",
        "termType": "术语",
