  "routing": {
    "note": "问答纪律的静态化表述：检索瀑布运行时真源见语义服务（skills/semantic-service）；成稿润色归人审后的使用方，本包只供确定性骨架。",
    "steps": [
      {
        "step": "①",
        "name": "显式锚定",
        "discipline": "问句带 @ID 时按前缀定模型定阵营（先阵营后存在性）：面内确认存在并反向收名下行为；面外拒答，不返回该元素任何细节。"
      },
      {
        "step": "②",
        "name": "名称解析",
        "discipline": "无锚定/锚定失败降级：候选词对 name/alias/属性标签/术语确定性分层匹配，不猜不模糊；多义列候选请锚定修饰词，不擅自合并。"
      },
      {
        "step": "③",
        "name": "闭包装配",
        "discipline": "命中元素沿引用/影响两向装配证据集（承载/行为/规则/查询出口/术语），只引用装配集内 ID，装配指令可复现。"
      },
      {
        "step": "④",
        "name": "可拒答",
        "discipline": "面外/仓内没有/禁用词三分支如实拒答：缺件分层说明+近邻指路；禁用词给替代口径真实 ID；写意图走提案流程。"
      }
    ]
  },
  "calibers": [
    {
      "id": "QR-HIS-001",
      "name": "院长驾驶舱 KPI 查询",
      "alias": "dashboardKpiQuery",
      "objectType": "STATISTICAL_QUERY",
      "questionSample": "院长驾驶舱 KPI 查询",
      "description": "日粒度院长驾驶舱出口（R13·§5.2.1 七字段对应五 KPI 卡）；异常预警面=退号率 RULE-HIS-001 阈值。ADS 实现=ads_dashboard_kpi。",
      "behavior": {
        "id": "BH-HIS-QueryDashboard",
        "name": "查询院长驾驶舱",
        "type": "QUERY",
        "ownerEntity": "AGG-HIS-001"
      },
      "sourceObjects": [
        {
          "objectRef": "AGG-HIS-001",
          "alias": "r",
          "primary": true,
          "name": "挂号记录"
        },
        {
          "objectRef": "AGG-HIS-004",
          "alias": "p",
          "primary": false,
          "name": "处方"
        },
        {
          "objectRef": "AGG-HIS-003",
          "alias": "d",
          "primary": false,
          "name": "诊断记录"
        }
      ],
      "parameters": [
        {
          "name": "startDay",
          "label": "开始日期",
          "dataType": "Date",
          "required": true
        },
        {
          "name": "endDay",
          "label": "结束日期",
          "dataType": "Date",
          "required": true
        }
      ],
      "rules": [
        {
          "id": "RULE-HIS-001",
          "name": "退号率告警阈值",
          "type": "VALIDATION",
          "point": {
            "expression": "refundRate <= 10"
          },
          "via": "behavior.appliedRules(BH-HIS-QueryDashboard)"
        },
        {
          "id": "RULE-HIS-003",
          "name": "退号率口径",
          "type": "CALCULATION",
          "point": {
            "expression": "refundCount / registerCount * 100"
          },
          "via": "behavior.appliedRules(BH-HIS-QueryDashboard)"
        },
        {
          "id": "RULE-HIS-005",
          "name": "处方退费率口径",
          "type": "CALCULATION",
          "point": {
            "expression": "refundPresc / totalPresc * 100"
          },
          "via": "behavior.appliedRules(BH-HIS-QueryDashboard)"
        },
        {
          "id": "RULE-HIS-002",
          "name": "支付方式收入占比合计校验",
          "type": "VALIDATION",
          "point": {
            "expression": "pctSum == 100"
          },
          "via": "ownerObjectBehaviors(AGG-HIS-001)"
        },
        {
          "id": "RULE-HIS-004",
          "name": "均次费用口径",
          "type": "CALCULATION",
          "point": {
            "expression": "totalRevenue / totalVisits"
          },
          "via": "ownerObjectBehaviors(AGG-HIS-001)"
        },
        {
          "id": "RULE-HIS-007",
          "name": "复诊率口径",
          "type": "CALCULATION",
          "point": {
            "expression": "revisitPatients / totalPatients * 100"
          },
          "via": "ownerObjectBehaviors(AGG-HIS-001)"
        },
        {
          "id": "RULE-HIS-006",
          "name": "病历完整率口径",
          "type": "CALCULATION",
          "point": {
            "expression": "filledDims / 5 * 100"
          },
          "via": "ownerObjectBehaviors(AGG-HIS-003)"
        }
      ],
      "hitIds": [
