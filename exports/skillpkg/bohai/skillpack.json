          "label": "井号",
          "dataType": "String",
          "required": true
        }
      ],
      "rules": [
        {
          "id": "RULE-BOHAI-005",
          "name": "井号归一化",
          "type": "TRANSFORMATION",
          "point": {
            "expression": "normalizeWellId(rawWellId)"
          },
          "via": "ownerObjectBehaviors(AGG-BOHAI-002)"
        },
        {
          "id": "RULE-BOHAI-002",
          "name": "计量化验含水偏差校验",
          "type": "VALIDATION",
          "point": {
            "expression": "abs(waterCut - waterCutLab) <= 5"
          },
          "via": "ownerObjectBehaviors(AGG-BOHAI-002)"
        },
        {
          "id": "RULE-BOHAI-003",
          "name": "日产油非空率校验",
          "type": "VALIDATION",
          "point": {
            "expression": "(totalCount - nullCount) / totalCount >= 0.995"
          },
          "via": "ownerObjectBehaviors(AGG-BOHAI-002)"
        },
        {
          "id": "RULE-BOHAI-004",
          "name": "日产恒值检测",
          "type": "VALIDATION",
          "point": {
            "narrative": "同井生产日期连续 30 日内 oilOutput 全部相同时判为恒值异常，返回 false（告警）"
          },
          "via": "ownerObjectBehaviors(AGG-BOHAI-002)"
        },
        {
          "id": "RULE-BOHAI-008",
          "name": "区块物质平衡校验",
          "type": "VALIDATION",
          "point": {
            "expression": "abs(blockInjVolume - blockLiquidVolume - retentionDelta) / blockLiquidVolume <= 0.03"
          },
          "via": "ownerObjectBehaviors(AGG-BOHAI-002)"
        },
        {
          "id": "RULE-BOHAI-009",
          "name": "产量完成率",
          "type": "CALCULATION",
          "point": {
            "expression": "actualOilSum / planOutputSum * 100"
          },
          "via": "ownerObjectBehaviors(AGG-BOHAI-002)"
        },
        {
          "id": "RULE-BOHAI-019",
          "name": "有效产量（剔检口径）",
          "type": "CALCULATION",
          "point": {
            "expression": "SUM(dailyProduction.oilOutput WHERE well.currentStatus <> '检修')"
          },
          "via": "ownerObjectBehaviors(AGG-BOHAI-002)"
        },
        {
          "id": "RULE-BOHAI-010",
          "name": "综合含水率",
          "type": "CALCULATION",
          "point": {
            "expression": "sum(case when waterCutLab is not null and abs(waterCutLab - waterCut) > 5 then liquidOutput * waterCutLab / 100 else liquidOutput - oilOutput end) / sum(liquidOutput) * 100  # B′ 化验校正（PROP-031，2026-09-21）：井·月粒度；化验配对经 RULE-BOHAI-002 中间视图（井号+取样日期双键+时间容差）"
          },
          "via": "ownerObjectBehaviors(AGG-BOHAI-002)"
        }
      ],
